<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot">

    <!-- use_sim:=true  -> Gazebo (default, your existing simulation keeps working)
         use_sim:=false -> real robot (ESP32 over serial) -->
    <xacro:arg name="use_sim" default="true"/>
    <xacro:arg name="serial_port" default="/dev/ttyUSB0"/>
    <xacro:arg name="enc_counts_per_rev" default="1920"/>

    <xacro:include filename="robot_core.xacro"/>

    <xacro:if value="$(arg use_sim)">
        <xacro:include filename="gazebo_control.xacro"/>
    </xacro:if>
    <xacro:unless value="$(arg use_sim)">
        <xacro:include filename="ros2_control.xacro"/>
    </xacro:unless>

</robot>
