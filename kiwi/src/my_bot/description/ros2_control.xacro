<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Real-robot version of gazebo_control.xacro: same 3 joints, but backed by the ESP32.
         Joint order matters: wheel_1_joint -> firmware slot 0 (LEFT),
                              wheel_2_joint -> slot 1 (RIGHT), wheel_3_joint -> slot 2 (BACK) -->
    <ros2_control name="KiwiHardware" type="system">
        <hardware>
            <plugin>kiwidrive_arduino/KiwiDriveArduino</plugin>
            <param name="device">$(arg serial_port)</param>
            <param name="baud_rate">115200</param>
            <param name="timeout">1000</param>
            <param name="loop_rate">30</param>
            <param name="enc_counts_per_rev">$(arg enc_counts_per_rev)</param>
        </hardware>

        <joint name="wheel_1_joint">
            <command_interface name="velocity"/>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>

        <joint name="wheel_2_joint">
            <command_interface name="velocity"/>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>

        <joint name="wheel_3_joint">
            <command_interface name="velocity"/>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>
    </ros2_control>

</robot>
